#!/usr/bin/env bash
# Only ALSA mixer commands are used here, as pulseaudio/pactl may not be running.

if [[ $# -eq 0 ]] ; then
    amixer get Speaker
    exit 0
fi

case "$1" in
    "set")
        if [[ $# -eq 2 ]] ; then
            amixer set Speaker "$2"
        elif [[ $# -eq 3 ]] ; then
            amixer set Speaker "$2" "$3"
        else
            echo -e "Both channels at once: volume set 75%\nOn different channels: volume set 75% 100%"
        fi
        ;;
    "mute") amixer set Speaker mute ;;
    "unmute") amixer set Speaker unmute ;;
    "help") echo "Usage: volume [set <value>|mute|unmute|help]" ;;
    *) echo "Command unknown" ;;
esac

