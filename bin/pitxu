#!/usr/bin/env bash
# Main pitxu executable

# Get the directory of the current script
# Allows to reference other files relative to this script's location
DIR="$( cd "$( dirname "$0" )" && pwd )"

# Get the real path of Poetry. We may be triggered by a systemd service.
POETRY="$(which poetry)"

# Main purpose: To be called from the serviced, from the service file
# Additional purpose: To be called directly to start pitxu in foreground for debugging
# Sould control the exit codes, as we may restart from pitxu itself
start_pitxu_foreground() {
    cd "$DIR/.." && $POETRY run main
    EXIT_CODE=$?
    return $EXIT_CODE
}

# Commandline to start the service
start_pitxu_background() {
    # To start pulseaudio as system-wide service (not recommended)
    # follow section 8.1: Starting system-wide on boot
    # https://wiki.archlinux.org/title/PulseAudio#Advanced_configuration_and_use_cases
    # Most likely user and group are already created. Ensure that YOUR user (or who runs pitxu)
    # is part of the "pulse-access" group.

    # sudo pulseaudio --check --system
    # sudo pulseaudio --check
    # EXIT_CODE=$?
    # if [ $EXIT_CODE -ne 0 ]; then
    #     echo "🔊 Pulseaudio is not running. Starting it now..."
    #     sudo pulseaudio --system -v --daemonize > "$DIR/../log/current_pulseaudio_process.log"
    # fi
	sudo systemctl start pitxu
}

# Commandline to stop the service
stop_pitxu_background() {
	sudo systemctl stop pitxu
    # sudo pulseaudio --check --system
    # sudo pulseaudio --check
    # EXIT_CODE=$?
    # if [ $EXIT_CODE -eq 0 ]; then
    #     echo "🔊 Pulseaudio is running. Stopping it now..."
    #     # sudo pulseaudio --kill
    #     kill $(ps aux | grep '[p]ulseaudio' | awk '{print $2}')
    # fi
}

# Commandline to restart the service
restart_pitxu_background() {
    sudo systemctl restart pitxu
}

status_pitxu_background() {
    sudo systemctl status pitxu
}

logs_journalctl_pitxu_background() {
    sudo journalctl -o cat -u pitxu -f
}

logs_journalctl_pulseaudio_background() {
    sudo journalctl -o cat --user-unit pulseaudio.service -f
}

logs_journalctl_all() {
    sudo journalctl -f
}

clear_pitxu_screen() {
     cd "$DIR/.." && poetry run clear
}

sounddevices() {
     cd "$DIR/.." && poetry run sounddevices
}


if [[ $# -eq 0 ]] ; then
    # No arguments provided, we start pitxu
    start_pitxu_foreground
    PITXU_EXIT_CODE=$?
    exit $PITXU_EXIT_CODE
fi

case "$1" in
    "start") start_pitxu_background ;;
    "stop") stop_pitxu_background ;;
    "restart") restart_pitxu_background ;;
    "status") status_pitxu_background ;;
    "logs") logs_journalctl_pitxu_background ;;
    "logs_pulseaudio") logs_journalctl_pulseaudio_background ;;
    "logs_all") logs_journalctl_all ;;
    "clear") clear_pitxu_screen ;;
    "sounddevices") sounddevices ;;
    "help") echo "Usage: pitxu [start|stop|restart|status|help|clear|sounddevices]" ;;
    *) echo "Command unknown" ;;
esac

FINAL_EXIT_CODE=$?
exit $FINAL_EXIT_CODE
