#!/usr/bin/env bash
# Main pitxu executable

# Get the directory of the current script
# Allows to reference other files relative to this script's location
DIR="$( cd "$( dirname "$0" )" && pwd )"

# Main purpose: To be called from the serviced, from the service file
# Additional purpose: To be called directly to start pitxu in foreground for debugging
# Sould control the exit codes, as we may restart from pitxu itself
start_pitxu_foreground() {
    cd "$DIR/.." && /home/xavier/.local/bin/poetry run main
    EXIT_CODE=$?
    return $EXIT_CODE
}

# Commandline to start the service
start_pitxu_background() {
    echo "🟢 Starting pitxu service..."
	sudo systemctl start pitxu
}

# Commandline to stop the service
stop_pitxu_background() {
    echo "🛑 Stopping pitxu service..."
	sudo systemctl stop pitxu
}

# Commandline to restart the service
restart_pitxu_background() {
    sudo systemctl restart pitxu
}

# Commandline to check the status of the service
status_pitxu_background() {
    sudo systemctl status pitxu
}

# Commandline to check the logs of the service
logs_journalctl_pitxu_background() {
    sudo journalctl -o cat -u pitxu -n 100 -f
}

# Commandline to check the logs of the whole system, for debugging
logs_journalctl_all() {
    sudo journalctl -o cat -n 100 -f
}

# Commandline to create the system links for ALSA configuration
link_alsa() {
    echo "Installing ALSA configuration for Pitxu"

    read -p "Link ALSA configuration file to /etc/asound.conf? (y)Yes/(n)No/(c)Cancel:- " choice
    case $choice in
        [yY]* ) sudo ln -s ~/pitxu/config/system/asound.conf /etc/asound.conf ;;
        [nN]* ) echo "Skipping." ;;
        [cC]* ) exit ;;
        *) exit ;;
    esac

    read -p "Link ALSA Card index definition to /etc/modprobe.d/sound.conf? (y)Yes/(n)No/(c)Cancel:- " choice
    case $choice in
        [yY]* ) sudo ln -s ~/pitxu/config/system/sound.conf /etc/modprobe.d/sound.conf ;;
        [nN]* ) echo "Skipping." ;;
        [cC]* ) exit ;;
        *) exit ;;
    esac
}

# Commandline to create the system links for system service and shutdown/reboot scripts
link_service() {
    echo "Installing system service and shutdown/reboot scripts for Pitxu"

    read -p "Link Pitxu service to /etc/systemd/system/pitxu.service? (y)Yes/(n)No/(c)Cancel:- " choice
    case $choice in
        [yY]* ) sudo ln -s ~/pitxu/config/system/pitxu.service /etc/systemd/system/pitxu.service ;;
        [nN]* ) echo "Skipping." ;;
        [cC]* ) exit ;;
        *) exit ;;
    esac

    read -p "Link Shutdown script to /etc/rc0.d/k99_cleanup_pitxu? (y)Yes/(n)No/(c)Cancel:- " choice
    case $choice in
        [yY]* ) sudo ln -s ~/pitxu/config/system/k99_cleanup_pitxu /etc/rc0.d/k99_cleanup_pitxu ;;
        [nN]* ) echo "Skipping." ;;
        [cC]* ) exit ;;
        *) exit ;;
    esac

    read -p "Link Reboot script to /etc/rc0.d/k99_cleanup_pitxu? (y)Yes/(n)No/(c)Cancel:- " choice
    case $choice in
        [yY]* ) sudo ln -s ~/pitxu/config/system/k99_cleanup_pitxu /etc/rc6.d/k99_cleanup_pitxu ;;
        [nN]* ) echo "Skipping." ;;
        [cC]* ) exit ;;
        *) exit ;;
    esac

    read -p "Reload systemctl daemon? (y)Yes/(n)No/(c)Cancel:- " choice
    case $choice in
        [yY]* ) sudo systemctl daemon-reload ;;
        [nN]* ) echo "Skipping." ;;
        [cC]* ) exit ;;
        *) exit ;;
    esac

    read -p "Enable the Pitxu service? (y)Yes/(n)No/(c)Cancel:- " choice
    case $choice in
        [yY]* ) sudo systemctl enable pitxu ;;
        [nN]* ) echo "Skipping." ;;
        [cC]* ) exit ;;
        *) exit ;;
    esac
}

# Commandline to clear the Pitxu screen
clear_pitxu_screen() {
     cd "$DIR/.." && poetry run clear
}

# Commandline to list the sound devices, for debugging
sounddevices() {
     cd "$DIR/.." && poetry run sounddevices
}

# Commandline to activate the screen cursor blinking
activate_cursor_blinking() {
     TERM=linux sudo setterm -cursor on -foreground white -clear all | sudo tee /dev/tty1
}

# Commandline to deactivate the screen cursor blinking
deactivate_cursor_blinking() {
    TERM=linux sudo setterm -cursor off -foreground black -clear all | sudo tee /dev/tty1
}

# Main commandline interface
# If no arguments are provided, we start pitxu in foreground
#   Keep in mind that the service file also calls this script without arguments to start the service, 
#   so this is the default behavior.
if [[ $# -eq 0 ]] ; then
    # No arguments provided, we start pitxu
    start_pitxu_foreground
    PITXU_EXIT_CODE=$?
    exit $PITXU_EXIT_CODE
fi

# If arguments are provided, we parse them as commands
case "$1" in
    "start") start_pitxu_background ;;
    "stop") stop_pitxu_background ;;
    "restart") restart_pitxu_background ;;
    "status") status_pitxu_background ;;
    "logs") logs_journalctl_pitxu_background ;;
    "logs_all") logs_journalctl_all ;;
    "clear") clear_pitxu_screen ;;
    "sounddevices") sounddevices ;;
    "link_alsa") link_alsa ;;
    "link_service") link_service ;;
    "cursor")
        case "$2" in
            "on") activate_cursor_blinking ;;
            "off") deactivate_cursor_blinking ;;
            *) echo "Usage: pitxu cursor [on|off]" ;;
        esac
        ;;
    "help") echo "Usage: pitxu [start|stop|restart|status|help|clear|sounddevices|link_alsa|link_service|cursor]" ;;
    *) echo "Command unknown" ;;
esac

# Control the exit code of the script, to allow restarting from pitxu itself if needed
#   Intended to react by the service file, which can be set to restart on failure, 
#   and to avoid restarting on normal exit.
FINAL_EXIT_CODE=$?
exit $FINAL_EXIT_CODE
