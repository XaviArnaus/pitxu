# Configuration to choose how and which displays are used.
displays:
  # [List] List of displays available to be used.
  # The root keys of this file are the available displays, but needs to be said explicitly here.
  # ⚠️ eink, matrix_led and lcd are legacy and DEPRECATED: they are behind the current implementation.
  #   Before using them, they need to be updated according to it (see pitxu/lib/legacy/README.md).
  available_displays:
    - eink
    - matrix_led
    - lcd
    - dsi_lcd
  # [String] The display to use for foreground notifications. Must be one of the available displays.
  # Foreground notifications are those that need to be shown immediately, like questions and answers from tools.
  foreground_display: dsi_lcd
  # [String] The display to use for background notifications. Must be one of the available displays.
  # Background notifications are those that react on the state of the system, like "listening", "thinking", "speaking", etc.
  background_display: dsi_lcd
  # [String] The display to use for the animations (the emojis, like "thinking"). Must be one of the available displays.
  # If it is not set, the background display is used.
  animations_display: dsi_lcd
  # [String] Status display to show the status lines, log style. Must be one of the available displays.
  status_display: dsi_lcd
  # [Bool] Avoid storing mocked images (avoids generating tons of PNGs while testing).
  # This is applied to all mocked displays, independently of the individual display configuration.
  discard_mocked_images: False

# Configuration fo the eInk Display
eink:
  # [Bool] Generates a PNG instead of outcoming through the eInk Display
  mock: True
  image: 
    # [String] Defines the image mode to base the canvas on. 1 for 1-bit B&W, L for greyscale, RGB for color
    mode: 1
  # [Bool] Do a full clear while initializing
  # KEEP AS TRUE. Seems like the eInk needs a full Clear on init to be able to show afterwards.
  initial_clear: True
  # Size of the display
  size:
    x: 250
    y: 122
  # [bool] Rotate the display 180 degrees or not. This only affects the eInk, not mocked.
  rotate: True
  # Configuration regarding the fonts
  fonts:
    ultra: 85
    huge: 45
    big: 22
    medium: 14
    small: 10
    small_emoji: 9
    tiny: 8
  # Defines the delays in seconds for the different interactions.
  # If not defined, defaults will be used.
  # In case of collision, the smallest delay will be used.
  delays:
    # [Float] Time showing the any foreground not attached to a Busy Flag event. Defaults to 3.0 secs
    foreground_notification: 3.0
    # [Float] Time showing the "startup splash" screen. Defaults to 3.0 secs
    startup_splash: 4.0
    # [Float] General delay between frames when animating. Defaults to 0.05 secs
    default_delay_between_frames: 0.05
    # [Float] Delay for the "thinking" animation frames. Defaults to default_delay_between_frames
    thinking: 0.05
    # [Float] Delay for the "speaking" animation frames. Defaults to default_delay_between_frames
    speaking: 0.06

# Configuration fo the Max7219 matrix led
matrix_led:
  # [Bool] Generates a PNG instead of outcoming through the eInk Display
  mock: True
  # [Bool] Discard mocked images (avoids generating tons of PNGs while testing).
  # Only works if mock is True
  discard_mocked_images: True
  # [Integer] The intensity of the leds, from 0 to 255
  intensity: 40
  # Size of the display
  size:
    x: 8
    y: 8
  # Defines the delays in seconds for the different interactions.
  # If not defined, defaults will be used.
  # In case of collision, the smallest delay will be used.
  delays:
    # [Float] Time showing the any foreground not attached to a Busy Flag event. Defaults to 3.0 secs
    foreground_notification: 3.0
    # [Float] Time showing the "startup splash" screen. Defaults to 3.0 secs
    startup_splash: 4.0
    # [Float] General delay between frames when animating. Defaults to 0.05 secs
    default_delay_between_frames: 0.05
    # [Float] Delay for the "thinking" animation frames. Defaults to default_delay_between_frames
    thinking: 0.05
    # [Float] Delay for the "speaking" animation frames. Defaults to default_delay_between_frames
    speaking: 0.06

lcd:
  # [Bool] Generates a PNG instead of outcoming through the ST7789P3 Display
  mock: True
  image: 
    # [String] Defines the image mode to base the canvas on. 1 for 1-bit B&W, L for greyscale, RGB for color, RGBA for color with transparency
    mode: RGBA
  # Size of the display
  size:
    x: 280
    y: 240
  # [Integer] Rotate the display these degrees.
  rotate: 90
  # Configuration regarding the fonts
  fonts:
    ultra: 85
    huge: 45
    big: 28
    medium: 24
    small: 20
    small_emoji: 16
    tiny: 16
  # Defines the delays in seconds for the different interactions.
  # If not defined, defaults will be used.
  # In case of collision, the smallest delay will be used.
  delays:
    # [Float] Time showing the any foreground not attached to a Busy Flag event. Defaults to 3.0 secs
    foreground_notification: 3.0
    # [Float] Time showing the "startup splash" screen. Defaults to 3.0 secs
    startup_splash: 4.0
    # [Float] Time showing a code block in the foreground. Defaults to 10.0 secs
    code_block_foreground_notification: 10.0
    # [Float] Time showing an error message in the foreground. Defaults to 3.0 secs
    error: 3.0
    # [Float] General delay between frames when animating. Defaults to 0.05 secs
    default_delay_between_frames: 0.05
    # [Float] Delay for the "thinking" animation frames. Defaults to default_delay_between_frames
    thinking: 0.06
    # [Float] Delay for the "speaking" animation frames. Defaults to default_delay_between_frames
    speaking: 0.01

dsi_lcd:
  # [Bool] Generates a PNG instead of outcoming through the ST7789P3 Display
  mock: True
  image: 
    # [String] Defines the image mode to base the canvas on. 1 for 1-bit B&W, L for greyscale, RGB for color, RGBA for color with transparency
    mode: RGBA
  # Size of the display
  size:
    x: 800
    y: 480
  # [bool] Rotate the display 180 degrees or not.
  rotate: False
  # Dim the backlight while the app is in idle mode, and restore it when it wakes up.
  idle_dimming:
    # [Bool] Enable the dimming. Defaults to True
    enabled: True
    # [Number] Brightness in percent (0-100) while idle. Defaults to 10
    brightness_percent: 10
    # [Number] Brightness in percent (0-100) to restore when awake (also applied at startup). Defaults to 100
    active_percent: 100
  # Configuration regarding the fonts
  fonts:
    # [String] Path and filename for the specific font to use in this screen
    # file: NotoColorEmoji-Regular.ttf
    # [Integer] Font size for Ultra big size
    ultra: 85
    # [Integer] Font size for Huge size
    huge: 45
    # [Integer] Font size for Big size
    big: 28
    # [Integer] Font size for Medium size
    medium: 24
    # [Integer] Font size for Small size
    small: 20
    # [Integer] Font size for Small size with correction for emoji
    small_emoji: 16
    # [Integer] Font size for Tiny size
    tiny: 16
  # Defines the delays in seconds for the different interactions.
  # If not defined, defaults will be used.
  # In case of collision, the smallest delay will be used.
  delays:
    # [Float] Time showing the any foreground not attached to a Busy Flag event. Defaults to 3.0 secs
    foreground_notification: 3.0
    # [Float] Time showing the "startup splash" screen. Defaults to 3.0 secs
    startup_splash: 4.0
    # [Float] Time showing a code block in the foreground. Defaults to 10.0 secs
    code_block_foreground_notification: 10.0
    # [Float] Time showing a text block in the foreground. Defaults to 10.0 secs
    text_block_foreground_notification: 10.0
    # [Float] Time showing the idle status in the foreground. Defaults to 10.0 secs
    idle_status_foreground_notification: 15.0
    # [Float] Time showing an error message in the foreground. Defaults to 3.0 secs
    error: 3.0
    # [Float] General delay between frames when animating. Defaults to 0.05 secs
    default_delay_between_frames: 0.05
    # [Float] Delay for the "thinking" animation frames. Defaults to default_delay_between_frames
    thinking: 0.08
    # [Float] Delay for the "speaking" animation frames. Defaults to default_delay_between_frames
    speaking: 0.05
    # [Float] Delay for the "idle" animation frames. Defaults to default_delay_between_frames
    idle: 0.02
  # Configuration of the Painter loop.
  painter:
    # [Bool] Logs (INFO) where the time of the painting loop goes: iterations per second, the CPU share of the Painter thread,
    #   and the average and maximum milliseconds per stage (clear, draw, merge, flush, wait...). It is reported every
    #   `timing_log_interval` seconds of activity and whenever the loop pauses. Meant for measuring, keep it off otherwise.
    timing_log: False
    # [Float] Seconds of activity between two timing reports. Defaults to 10.0
    timing_log_interval: 10.0
    # [Bool] Compose (and send to the display) only the rectangle of the screen that changed, instead of the whole screen
    #   on every frame. Defaults to True. False goes back to the whole screen every time. The mocked display always stores whole frames.
    partial_composition: True
    # [Bool] Debug: on every partial composition, also composes the whole screen apart and compares them. If they differ
    #   it logs a warning, and fixes the screen. Costs as much as a whole composition: keep it off unless you are checking.
    verify_partial: False
  # Configuration of the layout of the screen.
  layout:
    # The left column of the top row is shared by two areas: top_left (above) and center_left (below).
    center_left:
      # [Float] Share of the height of the column (minus the gap) taken by center_left, from 0.1 to 0.9. top_left gets the rest.
      height_share: 0.3
      # [Integer] Pixels between the outlines of top_left and center_left.
      gap: 6
      # How the effects in center_left (the mouth, the countdown and the scanner) look. Their sizes are proportional to the area.
      # [Integer] Columns of the KITT mouth: 3 or 5. With 5, the ones on the outside have even less rows.
      mouth_columns: 3
      # [Float] Gap between the columns of the mouth, in times the outer margin (12% of the height of the area).
      mouth_column_gap: 2.0
      # [Integer] Rounded corners of the rectangles, in pixels. 0 for square corners.
      corner_radius: 1
  # What this display shows for each state. Animations always go in the top left.
  # Displays with less resources keep their own fixed effects and do not read this.
  effects:
    # [String] Name of the animation (one of `animations.map`) shown while the chatbot is thinking.
    #   ⚠️ Remember to keep it in `animations.preload`, otherwise it loads the first time it is used.
    thinking: thinking
