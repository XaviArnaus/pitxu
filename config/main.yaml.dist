###########################
#     Pitxu Chatbot       #
###########################

# App Info
app:
  # Application name
  name: "Pitxu"
  # Which language to start with. Possible values "en-us", "ca", "de", "es"
  default_language: "ca"
  # Defines the supported languages. Must instersect STT, TTS and Gemini, and have definitions in this config.
  supported_languages: ["en-us", "ca", "de", "es"]
  # [String] Defines the execution mode of the app. Possible values:
  #   "local": Run as normal. The server is NOT started based on its own configuration.
  #   "public": Run as normal, but also start the server in the same process. This is useful for development and testing, to avoid having to start the server separately.
  #   "local_status": Run as local, but also start the server with only the "status" endpoint enabled.
  #   "server": Run only as server. The client is expected to be running separately,
  #     and will connect to this server to get STT, TTS and Chatbot interaction.
  #     There won't be any interaction in the local host, only serving the client requests.
  #   "client": Run only as client. The server is expected to be running separately,
  #     and the client will connect to it to get STT, TTS and Chatbot interaction. 
  execution_mode: "local_status"

# Filesystem definition
storage:
  # Where, from the root of the project
  path: "storage/"
  # General purpose state
  state_file: "state.yaml"
  # Mock files
  mocked_files:
    # [String] Path for mocked eInk output files
    eink: "mocked/eink/"
    # [String] Path for mocked LED output files
    led_matrix: "mocked/matrix/"
    # [String] Path for mocked LCD output files
    lcd: "mocked/lcd/"
    # [String] Path for mocked DSI LCD output files
    dsi_lcd: "mocked/dsi_lcd/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.png", ".keep"]
  # Audio dumped files paths
  audio:
    # [String] Path for audio files
    path: "audio/"
    # [String] Path for input audio files
    input: "input/"
    # [String] Path for preprocessed input audio files
    preprocessed_input: "preprocessed_input/"
    # [String] Path for output audio files
    output: "output/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.wav", ".keep"]
  # Audio signal plots dumped files paths
  signal_plots:
    # [String] Path for audio signal plot files
    path: "audio/signals/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.png", ".keep"]
  # Audio spectrogram plots dumped files paths
  spectrogram_plots:
    # [String] Path for audio spectrogram plot files
    path: "audio/spectrograms/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.png", ".keep"]
  # Audio fourier transform plots dumped files paths
  fourier_transform_plots:
    # [String] Path for audio fourier transform plot files
    path: "audio/fourier_transforms/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.png", ".keep"]

maintenance:
  # [Int] number of minutes of insactivity to consider the app idle and show some status information in the screen.
  idle_minutes: 2

# Fonts
fonts:
  # [String] Path for font files
  path: "pitxu/fonts"
  # [String] Default font file
  default_filename: "Font_with_emojis.ttc"

ups:
  # Whether to enable UPS support
  mock: True
  # I2C address of the UPS
  i2c_address: 0x36