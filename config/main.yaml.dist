###########################
#     Pitxu Chatbot       #
###########################

# App Info
app:
  # Application name
  name: "Pitxu"
  # Which language to start with. Possible values "en-us", "ca", "de", "es"
  default_language: "ca"
  # Defines the supported languages. Must instersect STT, TTS and Gemini, and have definitions in this config.
  supported_languages: ["en-us", "ca", "de", "es"]

# Filesystem definition
storage:
  # Where, from the root of the project
  path: "storage/"
  # General purpose state
  state_file: "state.yaml"
  # Mock files
  mocked_files:
    # [String] Path for mocked eInk output files
    eink: "mocked/eink/"
    # [String] Path for mocked LED output files
    led_matrix: "mocked/matrix/"
    # [String] Path for mocked LCD output files
    lcd: "mocked/lcd/"
    # [String] Path for mocked DSI LCD output files
    dsi_lcd: "mocked/dsi_lcd/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.png", ".keep"]

# Fonts
fonts:
  # [String] Path for font files
  path: "pitxu/fonts"
  # [String] Default font file
  default_filename: "Font_with_emojis.ttc"

ups:
  # Whether to enable UPS support
  mocked: True
  # I2C address of the UPS
  i2c_address: 0x36