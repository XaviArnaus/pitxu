###########################
#     Pitxu Chatbot       #
###########################

# App Info
app:
  # Application name
  name: "Pitxu"
  # Which language to start with. Possible values "en", "ca", "de", "es"
  default_language: "ca"
  # Defines the supported languages. Must instersect STT, TTS and Gemini, and have definitions in this config.
  supported_languages: ["en", "ca", "de", "es"]
  # [String] Defines the execution mode of the app. Possible values:
  #   "local": Run as normal. The server is NOT started based on its own configuration.
  #   "public": Run as normal, but also start the server in the same process. This is useful for development and testing, to avoid having to start the server separately.
  #   "local_status": Run as local, but also start the server with only the "status" endpoint enabled.
  #   "server": Run only as server. The client is expected to be running separately,
  #     and will connect to this server to get STT, TTS and Chatbot interaction.
  #     There won't be any interaction in the local host, only serving the client requests.
  #   "client": Run only as client. The server is expected to be running separately,
  #     and the client will connect to it to get STT, TTS and Chatbot interaction. 
  execution_mode: "local_status"
  # [String] Defines the wake up method. Possible values:
  #   "button": The user must press a button to wake up the app.
  #   "voice": The app will listen for a wake up word to wake up the app.
  #   "both": The app will listen for a wake up word and also allow the user to press a button to wake up the app.
  wake_up_method: "both" 
  # [Bool] The button also cuts the speech while it is being said, to get back to listening.
  #   It works whatever the wake_up_method is: the button is initialised for this alone if needed.
  button_interrupts_speech: true
  # [Bool] Show the thinking effect as soon as the user stops speaking, instead of when the transcription arrives.
  #   Only inside an ongoing interaction (hold time running), where the speech is almost certainly for the assistant.
  #   If the text then turns out empty or not for the chatbot, the effect is taken back.
  thinking_at_speech_end: true

# The doorbell: the processes ring each other when something changes in the shared memory,
#   so the monitors and the waits sleep until then instead of asking again every few milliseconds.
# Switches to tell if a problem comes from it. What is not here is on. Restart to apply.
doorbell:
  # [Bool] Everything. Off: nobody rings, and the monitors and the waits poll like they did before the doorbell.
  enabled: true
  # [Bool] The flag monitors (Main and the painter) listen to the doorbell.
  monitors: true
  # [Bool] The waits of Main (flags to be idle/busy, queues to be empty) listen to the doorbell.
  waiter: true

# Filesystem definition
storage:
  # Where, from the root of the project
  path: "storage/"
  # General purpose state
  state_file: "state.yaml"
  # Mock files
  mocked_files:
    # [String] Path for mocked eInk output files
    eink: "mocked/eink/"
    # [String] Path for mocked LED output files
    led_matrix: "mocked/matrix/"
    # [String] Path for mocked LCD output files
    lcd: "mocked/lcd/"
    # [String] Path for mocked DSI LCD output files
    dsi_lcd: "mocked/dsi_lcd/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.png", ".keep"]
  # Audio dumped files paths
  audio:
    # [String] Path for audio files
    path: "audio/"
    # [String] Path for input audio files
    input: "input/"
    # [String] Path for preprocessed input audio files
    preprocessed_input: "preprocessed_input/"
    # [String] Path for output audio files
    output: "output/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.wav", ".keep"]
  # Audio signal plots dumped files paths
  signal_plots:
    # [String] Path for audio signal plot files
    path: "audio/signals/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.png", ".keep"]
  # Audio spectrogram plots dumped files paths
  spectrogram_plots:
    # [String] Path for audio spectrogram plot files
    path: "audio/spectrograms/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.png", ".keep"]
  # Audio fourier transform plots dumped files paths
  fourier_transform_plots:
    # [String] Path for audio fourier transform plot files
    path: "audio/fourier_transforms/"
    # [list<String>] Exclude the following files from cleaning
    exclude_from_cleaning: ["_latest.png", ".keep"]

maintenance:
  # [Int] number of minutes of insactivity to consider the app idle and show some status information in the screen.
  idle_minutes: 2

# Fonts
fonts:
  # [String] Path for font files
  path: "pitxu/fonts"
  # [String] Default font file
  default_filename: "Font_with_emojis.ttc"
  # [String] font to be used for monospace text
  mono_filename: "Font.ttc"
  # [Integer] Index of the monospace font within the font file
  mono_index: 1

# Canvas configuration
canvas:
  # Markdown parser & renderer configuration
  markdown:
    # [Boolean] Whether to enable Markdown parsing and rendering
    enabled: True

# Timings
timings:
  # [Integer] Minutes to wait before entering into Idle mode. Defaults to 120 seconds (2 minutes).
  idle_minutes: 2

ups:
  # Whether to enable UPS support
  mock: True
  # I2C address of the UPS
  i2c_address: 0x36
  # [String] How to know whether the power cable is connected. 
  #   "gpio": reads the power loss detection pin of the UPS (GPIO6).
  #   "disabled": never reports it. The state is published as unknown, so the display does not claim anything.
  #   Use "disabled" if the pin does not reach the Pi (the internal pull-up then makes it always read "connected").
  power_cable_detection: gpio
  # [Integer] Battery percentage below which the battery button turns yellow.
  battery_warning_below: 40
  # [Integer] Battery percentage below which the battery button turns red. Green otherwise.
  battery_critical_below: 15