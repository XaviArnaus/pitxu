# Configurations for the Speech-to-Text
speech-to-text:
  # [Bool] Avoids using the Speech-to-Text and uses the keyboard input instead.
  mock: False
  # [Integer] Index of the car to use, from the list in `make sounddevices`. Set [None] for autodetect
  # input_device: 4 # MacOS connected to the USB Hub
  input_device: 0 # MacOS alone
  # [String] Engine to use for the Speech-to-Text.
  # Options: "vosk", "whisper", "faster_whisper", "faster_whisper_streaming" as the string used for the key in the configuration.
  # The "faster_whisper_streaming" option uses the config from the "faster_whisper" section, but it processes the audio in streaming mode.
  engine: "faster_whisper_streaming"
  # [Integer] Number of bytes to process in each chunk sent to the STT engine. This is a tradeoff between latency and performance.
  # It is applied only in the server module to split the received audio for processing.
  # bytes_per_chunk: 4000 # Working in Mac
  # bytes_per_chunk: 2048 # Working in Rpi
  bytes_per_chunk: 4000
  # [Integer] Number of samples to process in each chunk sent to the STT engine. This is a tradeoff between latency and performance.
  # It is applied in the main Input Stream setup (sounddevice.InputStream) and in the Capture Handler callback for VAD identification.
  # Defaults to 1024.
  blocksize: 1024
  # [Integer] The sample rate to use for the Audio Input used by the Mic itself.
  # -1 means that it will use the samplerate of the input device (Mic), inferred by the sounddevice library.
  # Note: this is not necessarily the same sample rate that the STT engine will use,
  #   as the audio will be resampled to match the one expected by the STT engine.
  # input_samplerate: 16000
  input_samplerate: -1
  # [Integer] The sample rate to resample to, before adding it into the processing queue of the STT engine.
  # This must match the sample rate expected by the STT engine (Vosk, Whisper, etc.),
  #   as well as the one set in the Preprocessor.
  target_samplerate: 16000
  # [Bool] Whether to save the preprocessed audio data to a file for debugging purposes.
  save_input_audio: True
  # [Bool] Generates plots for the audio signal (original and filtered) for debugging purposes.
  generate_signal_plots: True
  # [Bool] Generates plots for the audio spectrograms (original and filtered) for debugging purposes.
  generate_spectrogram_plots: True
  # [Bool] Generates plots for the audio Fourier transforms (original and filtered) for debugging purposes.
  generate_fourier_transform_plots: True
  # Configurtion for the Voice Activity Detection (VAD) module
  vad:
    # [Bool] VAD is activated or not.
    enabled: True
    # [Float] Threshold for the VAD to consider that there is voice activity.
    # This is a value between 0 and 1, where 0 means that any sound is considered voice and 1 means that only very loud sounds are considered voice.
    # threshold: 0.7 # Working in Mac
    # threshold: 0.8 # Working in RPi
    threshold: 0.7
    # [Float] Seconds before speech onset confirmed
    # attack: 0.050 # Working in Mac
    # attack: 0.060 # Working in RPi
    attack: 0.050
    # [Float] Seconds of silence before speech end
    release: 2.0
  # Configuration for the Preprocessor (filters noises, energy identification)
  preprocessor:
    # [Bool] Preprocessor is activated or not.
    enabled: True
    # [Integer] Low cut frequency for the bandpass filter in Hz.
    lowcut_freq: 300
    # lowcut_freq: 100
    # [Integer] High cut frequency for the bandpass filter in Hz.
    highcut_freq: 10000
    # [Integer] Order of the Butterworth filter used for preprocessing.
    filter_order: 3
    # [Integer] Sample rate to use for the preprocessor. This should match the input_samplerate.
    # Tipically, this value will be ignored, as the Preprocessor should receive it as param from the main
    # SpeechToText class. Understand this as a fallback value, in case the main SpeechToText class doesn't provide it.
    samplerate: 16000
    # [Bool] Whether to save the preprocessed audio data to a file for debugging purposes.
    save_preprocessed_audio: True
  # Specific configuration for Vosk, when applicable.
  vosk:
    # Model to use per language. If None (in a language), it will use the default SMALL one for the selected one.
    # See https://alphacephei.com/vosk/models
    model:
      # Catalan
      ca: vosk-model-small-ca-0.4
      # Spanish
      es: vosk-model-small-es-0.42
      # English
      en-us: vosk-model-small-en-us-0.15
      # German
      de: vosk-model-small-de-0.15
    # [Integer] The sample rate to use for the transcription model (Kaldi).
    # The value should be passed from the Main class, otherwise takes this value.
    # -1 means that it will infer the sample rate from the input device (Mic) using the sounddevice library.
    input_samplerate: 16000
  # Specific configuration for Whisper, when applicable.
  whisper:
    # Model to use per language. If None (in a language), it will use the default SMALL one for the selected one.
    # See https://github.com/openai/whisper# Models: tiny, base, small, medium, large. The ones with ".en" are optimized for English.
    model: 
      # Catalan
      ca: tiny
      # Spanish
      es: tiny
      # English
      # Attention: The rest of the app is still under "en-us", but all Whisper related uses just "en", 
      # and should replace the current app setup (leaving Vosk as the single exception, not the other way around)
      en: tiny.en
      # German
      de: tiny
    # [String] The location where the offline whisper files are stored.
    #   It will take the path starting from /storage or whatever is defined in the Main configuration for the storage_path, and then add this path to it.
    download_root: whisper
    # [String] The device to use for the Whisper model. Options: "cpu", "cuda", "mps", etc.
    #   See https://github.com/openai/whisper#usage for more details.
    device: cpu
    # [Bool] Whether to load the whole model in memory or not.
    #   Loading the whole model in memory can improve performance, but it can also consume more RAM. 
    #   If False, the model will be loaded on demand for each inference, which can save RAM but can increase latency.
    in_memory: True
  # Specific configuration for Faster Whisper, when applicable.
  faster_whisper:
    # Model to use per language. If None (in a language), it will use the default SMALL one for the selected one.
    # See https://github.com/openai/whisper# Models: tiny, base, small, medium, large. The ones with ".en" are optimized for English.
    model:
      # Catalan
      ca: small
      # Spanish
      es: small
      # English
      # Attention: The rest of the app is still under "en-us", but all Whisper related uses just "en", 
      # and should replace the current app setup (leaving Vosk as the single exception, not the other way around)
      en: small.en
      # German
      de: small
    # [String] The location where the offline faster whisper files are stored.
    #   It will take the path starting from /storage or whatever is defined in the Main configuration for the storage_path, and then add this path to it.
    download_root: faster_whisper
    # [String] The device to use for the Faster Whisper model. Options: "cpu", "cuda", "mps", etc.
    #   See https://github.com/SYSTRAN/faster-whisper for more details.
    device: cpu
    # [String] The compute type to use for the Faster Whisper model. Options: "int8", "int8_float16", "float16", "float32", etc.
    #   See https://github.com/SYSTRAN/faster-whisper for more details.
    compute_type: int8
    # [Bool] Allow transcription of multilingual input.
    # NOT YET USED
    multilingual: True
  # Specific configuration for Faster Whisper Streaming, when applicable.
  faster_whisper_streaming:
    # Model to use per language. If None (in a language), it will use the default SMALL one for the selected one.
    # See https://github.com/openai/whisper# Models: tiny, base, small, medium, large. The ones with ".en" are optimized for English.
    model:
      # Catalan
      ca: small
      # Spanish
      es: small
      # English
      # Attention: The rest of the app is still under "en-us", but all Whisper related uses just "en", 
      # and should replace the current app setup (leaving Vosk as the single exception, not the other way around)
      en: small.en
      # German
      de: small
    # [String] The location where the offline faster whisper files are stored.
    #   It will take the path starting from /storage or whatever is defined in the Main configuration for the storage_path, and then add this path to it.
    download_root: faster_whisper
    # [String] The device to use for the Faster Whisper model. Options: "cpu", "cuda", "mps", etc.
    #   See https://github.com/SYSTRAN/faster-whisper for more details.
    device: cpu
    # [String] The compute type to use for the Faster Whisper model. Options: "int8", "int8_float16", "float16", "float32", etc.
    #   See https://github.com/SYSTRAN/faster-whisper for more details.
    compute_type: int8
    # [Integer] The beam size for the inference. The bigger the more accurate, but also the slower.
    beam_size: 2
    # [Integer] The number of threads to use for the inference. Defaults to 4,
    #   but we should leave it lower than the actual CPU cores to allow the system to run smoothly and avoid overload.
    #   The main idea is to leave space for the Input Stream to provide chunks to the queue smoothly,
    #   and the rest of the system to keep itself responsive while the STT engine is processing the audio.
    num_threads: 3
    # [Integer] Samples to overlap between chunks when using the Faster Whisper model as streaming.
    #   The calculation goes like 2000 samples = 125ms (1 overlapping chunk of 4000 bytes at 16kHz sample rate).
    #   So pay attention to the parameter speech-to-text.bytes_per_chunk in the configuration above, as it will affect the optimal value for this parameter.
    overlap_size: 8000
    # [Integer] The number of chunks to accumulate before processing the audio with the Faster Whisper model. This is a tradeoff between latency and performance.
    chunks_window: 100
    # [Float] The time in seconds to sleep when there are no chunks to process in the queue, in the Faster Whisper Streaming implementation. This is to avoid busy waiting and to give time to the other thread to add chunks to the queue.
    sleep_when_no_chunks: 0.1
    # [List of Strings] Hot words to add to the Faster Whisper model for each language.
    # The name of the bot and its possible aliases will be added automatically.
    hot_words:
      # Catalan
      ca: []
      # Spanish
      es: []
      # English
      en: []
      # German
      de: []
    # [Float] The hallucination threshold for silences, in seconds.
    hallucination_silence_threshold: 1.0
    # [Integer] The maximum number of characters to use from the ongoing transcription as a prompt for the next chunk.
    max_prompt_buffer_size_in_chars: 100
    # [Float] The temperature to use for the inference. The higher, the more creative (and less accurate) the transcription will be.
    temperature: 0.2
    # [Float] The confidence threshold to consider that a segment is low confidence
    #   (should be reprocessed with a lower temperature?)
    segment_low_confidence_threshold: -1
    # [Float] The confidence threshold to consider that a word is low confidence
    word_low_confidence_threshold: 0.1
    # [Float] The threshold of confidence over the segments to consider that the model is hallucinating.
    hallucination_low_confidence_segments_threshold: -1
    # [Float] The threshold of confidence to reset the hallucination counter.
    #   If the average confidence of the segments is above this threshold, the counter will be reset.
    hallucination_low_confidence_reset_threshold: -1
    # [Integer] The maximum number of occurrences of low confidence segments before considering the transcription ashallucination.
    hallucination_low_confidence_segments_max_occurrences: 3

# Configurations for the Text-to-Speech
text-to-speech:
  # [Bool] Avoids using the Speech-to-Text and uses the keyboard input instead.
  mock: False
  # [Integer] Index of the card to use, from the list in `make sounddevice`. Set [None] for autodetect
  # output_device: 5 # MacOS connected to the USB Hub
  output_device: 1 # MacOS alone
  # [String] ALSA control name for the speakers. Only used on Linux with ALSA.
  alsa_speaker_control_name: "Speaker"
  # alsa_speaker_control_name: "Master"
  # [String] ALSA control name for the microphone. Only used on Linux with ALSA.
  # alsa_mic_control_name: "Mic"
  alsa_mic_control_name: "Capture"
  # [String] Is the microphone understood by ALSA as Mono? Otherwise will be stereo.
  # This is important because the reading of the values won't work otherwise.
  alsa_is_mic_mono: True
  # [Integer] Volume addition to the volume level read from the system.
  add_to_output_volume: 0
  # Model per language. There has to be always 2 related files: *.onnx and *.onnx.json
  per_language:
    # Catalan
    ca: 
      male: ca_ES-upc_pau-x_low
      female: ca_ES-upc_ona-x_medium
    # Spanish
    es: 
      male: es_ES-davefx-medium
      female: es_ES-sharvard-medium
    # English
    en-us: 
      male: en_US-joe-medium
      female: en_GB-jenny_dioco-medium
    # German
    de: 
      male: de_DE-karlsson-low
      female: de_DE-thorsten-low