# A minimal configuration for PulseAudio that worked for a while
#   until anything else exploded. Interesting to keep anyhow.
#
# 2026-02-08 
#   Not linked anymore, as Pitxu works under ALSA (system) / PortAudio (python) only
#
# Copy or link this file into ~/.config/pulse/default.pa
# Then restart pulseaudio with:
#   systemctl --user restart pulseaudio.service
# Then finally the devices appear to be fixed:
#   pactl list

### Automatically restore the volume of streams and devices
load-module module-device-restore
load-module module-stream-restore restore_device=false
load-module module-card-restore

# XA: This is the original: https://superuser.com/a/1158248
load-module module-alsa-sink device=default
# Ref: https://www.freedesktop.org/wiki/Software/PulseAudio/Documentation/User/Modules/?__goaway_challenge=meta-refresh&__goaway_id=f311b78f40fa54b115cad322fcce8715&__goaway_referer=https%3A%2F%2Fduckduckgo.com%2F#module-alsa-source
#load-module module-alsa-source device_id=0
load-module module-alsa-source device=default

### Automatically load driver modules depending on the hardware available
#.ifexists module-udev-detect.so
#load-module module-udev-detect tsched=0
#.else
### Use the static hardware detection module (for systems that lack udev support)
#load-module module-detect
#.endif

load-module module-native-protocol-unix