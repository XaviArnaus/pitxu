# General settings about language
language:
  # Trigger words to start an interaction (lowercase, no accents)
  trigger_words:
    ca: ["hola %s", "ep %s", "ei %s", "bon dia %s", "bona tarda %s", "bona nit %s", "escolta %s", "%s"]
    es: ["hola %s", "eh %s", "oye %s", "buenos días %s", "buenas tardes %s", "buenas noches %s", "escucha %s", "%s"]
    en: ["hello %s", "hi %s", "hey %s", "good morning %s", "good afternoon %s", "good evening %s", "listen %s", "%s"]
    de: ["hallo %s", "hi %s", "hey %s", "guten morgen %s", "guten tag %s", "guten abend %s", "hör zu %s", "%s"]
  # Answers to trigger words only, that wake up the chatbot. Will choose one random.
  trigger_answers:
    ca: ["Digues", "Què passa?", "Què tal?"]
    es: ["Dime", "¿Qué pasa?", "¿Qué tal?"]
    en: ["Tell me", "What's up?", "How's it going?"]
    de: ["Sag es mir", "Was gibt's?", "Wie läuft's?"]
  # What Pitxu says when the chatbot understood that the user ends the conversation (then it goes idle). Will choose one random.
  end_of_conversation_answers:
    ca: ["Fins ara!", "Ens veiem!", "Aquí estaré quan em necessitis."]
    es: ["¡Hasta luego!", "¡Nos vemos!", "Aquí estaré cuando me necesites."]
    en: ["See you later!", "Talk to you soon!", "I'll be here when you need me."]
    de: ["Bis später!", "Bis bald!", "Ich bin hier, wenn du mich brauchst."]
  # Exit words are used to identify the program termination (lowercase, no accents)
  exit_words:
    ca: ["sortir", "adeu"]
    es: ["salir", "adios"]
    en: ["exit", "quit", "bye", "goodbye", "good bye", "goodb"]
    de: ["tschüss", "beenden", "ende"]
  # [String] Warm up question. Should be simple and without using external tools
  warmup_question: 
    ca: "Reconeix que estàs llest, i recupera les últimes 5 entrades de memòria per agafar context (només són les més recents; la resta de la informació es troba cercant)."
    es: "Reconoce que estás listo, y recupera las últimas 5 entradas de memoria para obtener contexto (solo son las más recientes; el resto de la información se encuentra buscando)."
    en: "Acknowledge that you are ready, and retrieve the last 5 memory entries to gain context (they are only the most recent ones; the rest of the information is found by searching)."
    de: "Bestätige, dass du bereit bist, und rufe die letzten 5 Speicher-Einträge ab, um Kontext zu erhalten (sie sind nur die neuesten; die übrigen Informationen findest du durch Suchen)."
  # This is the welcome / greeting message
  greeting:
    ca: "Hola"
    es: "Hola"
    en: "Hello"
    de: "Hallo"
  # Welcome message based on the time of the day
  greeting_morning:
    ca: "Bon dia"
    es: "Buenos días"
    en: "Good morning"
    de: "Guten Morgen"
  greeting_afternoon:
    ca: "Bona tarda"
    es: "Buenas tardes"
    en: "Good afternoon"
    de: "Guten Tag"
  greeting_evening:
    ca: "Bona nit"
    es: "Buenas noches"
    en: "Good evening"
    de: "Guten Abend"
  greeting_night:
    ca: "Bona nit"
    es: "Buenas noches"
    en: "Good night"
    de: "Gute Nacht"
  # This is the goodbye message
  goodbye:
    ca: "Fins la propera! Adéu!"
    es: "Hasta la próxima! Adiós"
    en: "See you next time! Goodbye!"
    de: "Bis zum nächsten Mal! Auf Wiedersehen!"
  general_error:
    ca: "Ho sento, ha hagut un error inesperat."
    es: "Lo siento, ha habido un error inesperado."
    en: "I'm sorry, there was an unexpected error."
    de: "Es tut mir leid, es gab einen unerwarteten Fehler."
  server_error:
    ca: "Ho sento, el servidor retorna error."
    es: "Lo siento, el servidor devuelve un error."
    en: "I'm sorry, the server returned an error."
    de: "Es tut mir leid, der Server hat einen Fehler zurückgegeben."
  api_error:
    ca: "Ho sento, el servidor ha retornat un error de l'API."
    es: "Lo siento, el servidor ha devuelto un error de API."
    en: "I'm sorry, the server returned an API error."
    de: "Es tut mir leid, der Server hat einen API-Fehler zurückgegeben."
  quota_exceeded_error:
    ca: "Ho sento, la quota s'ha excedit. Espera %s segons abans de tornar-ho a provar."
    es: "Lo siento, la cuota se ha excedido. Espera %s segundos antes de volver a intentarlo."
    en: "I'm sorry, the quota has been exceeded. Wait %s seconds before retrying."
    de: "Es tut mir leid, das Kontingent wurde überschritten. Warten Sie %s Sekunden, bevor Sie es erneut versuchen."
  client_error:
    ca: "Ho sento, sembla que hi ha un error de client."
    es: "Lo siento, parece que hay un error de cliente."
    en: "I'm sorry, it seems there is a client error."
    de: "Es tut mir leid, es scheint ein Client-Fehler vorzuliegen."
  connection_closed_error:
    ca: "Ho sento, el servidor retorna error: la connexió s'ha tancat."
    es: "Lo siento, el servidor devuelve un error: la conexión se ha cerrado."
    en: "I'm sorry, the server returned an error: the connection was closed."
    de: "Es tut mir leid, der Server hat einen Fehler zurückgegeben: die Verbindung wurde geschlossen."
  empty_answer:
    ca: "Ho sento, no et puc donar una resposta ara."
    es: "Lo siento, no puedo darte una respuesta ahora."
    en: "I'm sorry, I can't give you an answer right now."
    de: "Es tut mir leid, ich kann dir gerade keine Antwort geben."
  language_not_supported:
    ca: "L'idioma '%s' no està suportat."
    es: "El idioma '%s' no está soportado."
    en: "The language '%s' is not supported."
    de: "Die Sprache '%s' wird nicht unterstützt."
  transcription_error:
    ca: "No t'he entès."
    es: "No te he entendido."
    en: "I didn't understand you."
    de: "Ich habe dich nicht verstanden."
  connectivity_error:
    ca: "No puc connectar amb el servidor."
    es: "No puedo conectar con el servidor."
    en: "I can't connect to the server."
    de: "Ich kann keine Verbindung zum Server herstellen."
  languages_per_language:
    ca:
      en: "anglès"
      ca: "català"
      es: ["espanyol", "castellà"]
      de: "alemany"
    es:
      en: "inglés"
      ca: "catalán"
      es: ["español", "castellano"]
      de: "alemán"
    en:
      en: "English"
      ca: "Catalan"
      es: "Spanish"
      de: "German"
    de:
      en: "Englisch"
      ca: "Katalanisch"
      es: "Spanisch"
      de: "Deutsch"
  language_codes_per_language:
    en: "en"
    ca: "ca"
    es: "es"
    de: "de"
  # Common text replacements to normalize output
  text_replacements:
    ca:
      "&amp;": "i"
      "&lt;": "menor que"
      "&gt;": "major que"
      "&quot;": ""
      "&#39;": ""
      "etc.": "etcètera"
      "°C": "graus"
      "km/h": "quilòmetres per hora"
      "e.g.": "per exemple"
      "vs.": "versus"
    es:
      "&amp;": "y"
      "&lt;": "menor que"
      "&gt;": "mayor que"
      "&quot;": ""
      "&#39;": ""
      "etc.": "etcétera"
      "°C": "grados"
      "km/h": "kilómetros por hora"
      "e.g.": "por ejemplo"
      "vs.": "versus"
    en:
      "&amp;": "and"
      "&lt;": "less than"
      "&gt;": "greater than"
      "&quot;": ""
      "&#39;": ""
      "etc.": "etcetera."
      "°C": "degrees"
      "km/h": "kilometers per hour"
      "e.g.": "for example"
      "vs.": "versus"
    de:
      "&amp;": "und"
      "&lt;": "kleiner als"
      "&gt;": "größer als"
      "&quot;": ""
      "&#39;": ""
      "etc.": "etcetera."
      "°C": "Grad"
      "km/h": "Kilometer pro Stunde"
      "e.g.": "zum Beispiel"
      "vs.": "gegen"
  
  # Replacements at TTS only to improve pronunciation
  tts_text_replacements:
    ca:
      "Xavi": "Txabi"
    es:
      "Xavi": "Chabi"
    en:
      "Xavi": "Chabee"
    de:
      "Xavi": "Chabi"
  
  # Expressions to remove from transcription
  transcription_remove_expressions:
    ca: ["urn", "um", "ye", "uh", "uhm", "ahm", "umm", "hmm", "mm", "uh", "ah", "mhm", "uhhh", "ahhh", "ummm", "hmmm", "mmhmm"]
    es: ["urn", "um", "ye", "uh", "uhm", "ahm", "umm", "hmm", "mm", "uh", "ah", "mhm", "uhhh", "ahhh", "ummm", "hmmm", "mmhmm"]
    en: ["urn", "um", "ye", "uh", "uhm", "ahm", "umm", "hmm", "mm", "uh", "ah", "mhm", "uhhh", "ahhh", "ummm", "hmmm", "mmhmm"]
    de: ["urn", "um", "ye", "uh", "uhm", "ahm", "umm", "hmm", "mm", "uh", "ah", "mhm", "uhhh", "ahhh", "ummm", "hmmm", "mmhmm"]

  # Punctuations to count on for the word-based partial transcriptions
  word_based_partial_transcriptions_punctuations:
    ca: [".", ",", "!", "?", ";", ":", "..."]
    es: [".", ",", "!", "?", ";", ":", "..."]
    en: [".", ",", "!", "?", ";", ":", "..."]
    de: [".", ",", "!", "?", ";", ":", "..."]

  # Sentences to remove by the end of the transcription
  #   also understood as "hallucinations" of the STT engine.
  transcription_hallucinations:
    ca: ["thank you for watching", "thanks for watching", "subscribe for more"]
    es: ["thank you for watching", "thanks for watching", "subscribe for more"]
    en: ["thank you for watching", "thanks for watching", "subscribe for more"]
    de: ["thank you for watching", "thanks for watching", "subscribe for more"]

  # Reminders
  reminders:
    reminder_set:
      ca: "Recordatori establert per al %s a les %s: '%s'."
      es: "Recordatorio establecido para el %s a las %s: '%s'."
      en: "Reminder set for %s at %s: '%s'."
      de: "Erinnerung gesetzt für den %s um %s: '%s'."
    reminder_invalid_date:
      ca: "Data invàlida. Si us plau, utilitza el format Any-Mes-Dia (per exemple, 2023-12-25)."
      es: "Fecha inválida. Por favor, utiliza el formato Año-Mes-Día (por ejemplo, 2023-12-25)."
      en: "Invalid date. Please use the Year-Month-Day format (e.g., 2023-12-25)."
      de: "Ungültiges Datum. Bitte verwende das Format Jahr-Monat-Tag (z.B. 2023-12-25)."
    reminder_invalid_time:
      ca: "Hora invàlida. Si us plau, utilitza el format HH:MM en format de 24 hores (per exemple, 14:30)."
      es: "Hora inválida. Por favor, utiliza el formato HH:MM en formato de 24 horas (por ejemplo, 14:30)."
      en: "Invalid time. Please use the HH:MM format in 24-hour format (e.g., 14:30)."
      de: "Ungültige Uhrzeit. Bitte verwende das Format HH:MM im 24-Stunden-Format (z.B. 14:30)."
    reminder_past_datetime:
      ca: "No es pot establir un recordatori per a una data i hora passada."
      es: "No se puede establecer un recordatorio para una fecha y hora pasada."
      en: "Cannot set a reminder for a past date and time."
      de: "Es kann keine Erinnerung für ein vergangenes Datum und eine vergangene Uhrzeit festgelegt werden."
    reminder_creation_error:
      ca: "Ho sento, hi ha hagut un error en crear el recordatori."
      es: "Lo siento, ha habido un error al crear el recordatorio."
      en: "I'm sorry, there was an error creating the reminder."
      de: "Es tut mir leid, es gab einen Fehler beim Erstellen der Erinnerung."
    reminder_list_empty:
      ca: "No hi ha recordatoris establerts."
      es: "No hay recordatorios establecidos."
      en: "There are no reminders set."
      de: "Es sind keine Erinnerungen gesetzt."
    reminder_count_one:
      ca: "1 recordatori."
      es: "1 recordatorio."
      en: "1 reminder."
      de: "1 Erinnerung."
    reminder_count_many:
      ca: "%d recordatoris."
      es: "%d recordatorios."
      en: "%d reminders."
      de: "%d Erinnerungen."
    reminder_retrieval_error:
      ca: "Ho sento, hi ha hagut un error en recuperar els recordatoris."
      es: "Lo siento, ha habido un error al recuperar los recordatorios."
      en: "I'm sorry, there was an error retrieving the reminders."
      de: "Es tut mir leid, es gab einen Fehler beim Abrufen der Erinnerungen."
    reminder_deleted:
      ca: "Recordatori eliminat per al %s a les %s."
      es: "Recordatorio eliminado para el %s a las %s."
      en: "Reminder deleted for %s at %s."
      de: "Erinnerung gelöscht für den %s um %s."
    reminder_not_found:
      ca: "No s'ha trobat cap recordatori amb l'id %s."
      es: "No se ha encontrado ningún recordatorio con el id %s."
      en: "No reminder found with the id %s."
      de: "Keine Erinnerung mit der ID %s gefunden."
    reminder_deletion_error:
      ca: "Ho sento, hi ha hagut un error en eliminar el recordatori."
      es: "Lo siento, ha habido un error al eliminar el recordatorio."
      en: "I'm sorry, there was an error deleting the reminder."
      de: "Es tut mir leid, es gab einen Fehler beim Löschen der Erinnerung."
    reminder_announcement:
      ca: "Recordatori: %s"
      es: "Recordatorio: %s"
      en: "Reminder: %s"
      de: "Erinnerung: %s"
    reminder_announcement_multiple:
      ca: "Tens %d recordatoris: %s"
      es: "Tienes %d recordatorios: %s"
      en: "You have %d reminders: %s"
      de: "Du hast %d Erinnerungen: %s"
    reminder_screen_title:
      ca: "Recordatoris"
      es: "Recordatorios"
      en: "Reminders"
      de: "Erinnerungen"
    reminder_item_late_today:
      ca: "A les %s, %s"
      es: "A las %s, %s"
      en: "At %s, %s"
      de: "Um %s, %s"
    reminder_item_late_other_day:
      ca: "El %s a les %s, %s"
      es: "El %s a las %s, %s"
      en: "On %s at %s, %s"
      de: "Am %s um %s, %s"
    reminder_very_old_warning:
      ca: "Aquest recordatori és molt antic i no es va poder anunciar en el seu moment."
      es: "Este recordatorio es muy antiguo y no se pudo anunciar en su momento."
      en: "This reminder is very old and could not be announced back then."
      de: "Diese Erinnerung ist sehr alt und konnte damals nicht angekündigt werden."
    reminder_history_notice:
      ca: "L'aplicació acaba d'anunciar en veu alta, pel seu compte, els recordatoris amb aquests ids: %s. L'usuari no ha dit res."
      es: "La aplicación acaba de anunciar en voz alta, por su cuenta, los recordatorios con estos ids: %s. El usuario no ha dicho nada."
      en: "The application just announced out loud, on its own, the reminders with these ids: %s. The user did not say anything."
      de: "Die Anwendung hat soeben von sich aus die Erinnerungen mit diesen IDs laut angekündigt: %s. Der Benutzer hat nichts gesagt."
    reminder_memory_summary_one:
      ca: "Recordatori anunciat: %s"
      es: "Recordatorio anunciado: %s"
      en: "Reminder announced: %s"
      de: "Erinnerung angekündigt: %s"
    reminder_memory_summary_many:
      ca: "%d recordatoris anunciats"
      es: "%d recordatorios anunciados"
      en: "%d reminders announced"
      de: "%d Erinnerungen angekündigt"
    reminder_memory_content:
      ca: "A les %s el Pitxu va anunciar en veu alta: %s (ids dels recordatoris: %s)"
      es: "A las %s Pitxu anunció en voz alta: %s (ids de los recordatorios: %s)"
      en: "At %s Pitxu announced out loud: %s (reminder ids: %s)"
      de: "Um %s hat Pitxu laut angekündigt: %s (IDs der Erinnerungen: %s)"
    reminder_update_error:
      ca: "Ho sento, hi ha hagut un error en actualitzar el recordatori."
      es: "Lo siento, ha habido un error al actualizar el recordatorio."
      en: "I'm sorry, there was an error updating the reminder."
      de: "Es tut mir leid, es gab einen Fehler beim Aktualisieren der Erinnerung."
    reminder_updated:
      ca: "Recordatori actualitzat per al %s a les %s: '%s'."
      es: "Recordatorio actualizado para el %s a las %s: '%s'."
      en: "Reminder updated for %s at %s: '%s'."
      de: "Erinnerung aktualisiert für den %s um %s: '%s'."
    reminder_move_error:
      ca: "Ho sento, hi ha hagut un error en moure el recordatori."
      es: "Lo siento, ha habido un error al mover el recordatorio."
      en: "I'm sorry, there was an error moving the reminder."
      de: "Es tut mir leid, es gab einen Fehler beim Verschieben der Erinnerung."
    reminder_moved:
      ca: "Recordatori mogut de %s a les %s a %s a les %s."
      es: "Recordatorio movido de %s a las %s a %s a las %s."
      en: "Reminder moved from %s at %s to %s at %s."
      de: "Erinnerung verschoben von %s um %s zu %s um %s."
  
  # Lists
  lists:
    list_creation_error:
      ca: "Ho sento, hi ha hagut un error en crear la llista."
      es: "Lo siento, ha habido un error al crear la lista."
      en: "I'm sorry, there was an error creating the list."
      de: "Es tut mir leid, es gab einen Fehler beim Erstellen der Liste."
    list_retrieval_error:
      ca: "Ho sento, hi ha hagut un error en recuperar la llista."
      es: "Lo siento, ha habido un error al recuperar la lista."
      en: "I'm sorry, there was an error retrieving the list."
      de: "Es tut mir leid, es gab einen Fehler beim Abrufen der Liste."
    list_update_error:
      ca: "Ho sento, hi ha hagut un error en actualitzar la llista."
      es: "Lo siento, ha habido un error al actualizar la lista."
      en: "I'm sorry, there was an error updating the list."
      de: "Es tut mir leid, es gab einen Fehler beim Aktualisieren der Liste."
    list_deletion_error:
      ca: "Ho sento, hi ha hagut un error en eliminar la llista."
      es: "Lo siento, ha habido un error al eliminar la lista."
      en: "I'm sorry, there was an error deleting the list."
      de: "Es tut mir leid, es gab einen Fehler beim Löschen der Liste."
    # Adding, changing, marking, removing and restoring items.
    list_items_error:
      ca: "Ho sento, hi ha hagut un error en treballar amb els elements de la llista."
      es: "Lo siento, ha habido un error al trabajar con los elementos de la lista."
      en: "I'm sorry, there was an error working with the items of the list."
      de: "Es tut mir leid, es gab einen Fehler bei der Arbeit mit den Elementen der Liste."
    # %s: the name that was said, and the names of the lists that exist.
    list_not_found:
      ca: "No hi ha cap llista anomenada '%s'. Llistes existents: %s. Per fer-ne una de nova, crea-la amb create_list."
      es: "No hay ninguna lista llamada '%s'. Listas existentes: %s. Para hacer una nueva, créala con create_list."
      en: "There is no list called '%s'. Existing lists: %s. To make a new one, create it with create_list."
      de: "Es gibt keine Liste namens '%s'. Vorhandene Listen: %s. Um eine neue anzulegen, erstelle sie mit create_list."
    # %s: the name that was said.
    list_not_found_empty:
      ca: "No hi ha cap llista anomenada '%s', i encara no hi ha cap llista. Per fer-ne una, crea-la amb create_list."
      es: "No hay ninguna lista llamada '%s', y todavía no hay ninguna lista. Para hacer una, créala con create_list."
      en: "There is no list called '%s', and there are no lists yet. To make one, create it with create_list."
      de: "Es gibt keine Liste namens '%s', und es gibt noch keine Listen. Um eine anzulegen, erstelle sie mit create_list."
    # %s: the name that was said, and the names of the lists that could be it.
    list_ambiguous:
      ca: "'%s' podria ser més d'una llista: %s. Pregunta a l'usuari quina vol dir."
      es: "'%s' podría ser más de una lista: %s. Pregunta al usuario cuál quiere decir."
      en: "'%s' could be more than one list: %s. Ask the user which one they mean."
      de: "'%s' könnte mehr als eine Liste sein: %s. Frage den Benutzer, welche er meint."
    # %s: the id that was given.
    item_not_found:
      ca: "No hi ha cap element amb l'id %s."
      es: "No hay ningún elemento con el id %s."
      en: "There is no item with the id %s."
      de: "Es gibt kein Element mit der ID %s."
    # %s: the name of the list that already has the name.
    list_name_taken:
      ca: "Ja hi ha una llista anomenada '%s'. No s'ha canviat res."
      es: "Ya hay una lista llamada '%s'. No se ha cambiado nada."
      en: "There is already a list called '%s'. Nothing was changed."
      de: "Es gibt bereits eine Liste namens '%s'. Es wurde nichts geändert."
    list_name_missing:
      ca: "Una llista necessita un nom."
      es: "Una lista necesita un nombre."
      en: "A list needs a name."
      de: "Eine Liste braucht einen Namen."
    list_check_needs_target:
      ca: "Dona els ids dels elements o el nom d'una llista, però no les dues coses ni cap."
      es: "Da los ids de los elementos o el nombre de una lista, pero ni las dos cosas ni ninguna."
      en: "Give either the ids of the items or the name of a list, not both and not none."
      de: "Gib entweder die IDs der Elemente oder den Namen einer Liste an, nicht beides und nicht keins."
    list_restore_needs_target:
      ca: "Dona els ids dels elements eliminats o el nom d'una llista."
      es: "Da los ids de los elementos eliminados o el nombre de una lista."
      en: "Give the ids of the removed items or the name of a list."
      de: "Gib die IDs der entfernten Elemente oder den Namen einer Liste an."

  # Code generation
  code:
    # This is the speech for an empty answer with code, to introduce the code block.
    empty_answer_with_code:
      ca: "Aquí tens el codi:"
      es: "Aquí tienes el código:"
      en: "Here is the code:"
      de: "Hier ist der Code:"
    # This is the text to add at the end of the answer when there was a code block that couldn't be extracted properly.
    unable_to_extract_code_callback_text_addendum:
      ca: "⚠️ La resposta inclou un bloc de codi que no s'ha pogut extraurear correctamente. Si quieres verlo, por favor pide a Pitxu que te envíe la respuesta completa a un email o algo así."
      es: "⚠️ La respuesta incluye un bloque de código que no se ha podido extraer correctamente. Si quieres verlo, por favor pide a Pitxu que te envíe la respuesta completa a un email o algo así."
      en: "⚠️ The response includes a code block that couldn't be extracted properly. If you want to see it, please ask Pitxu to send you the full response to an email or something like that."
      de: "⚠️ Die Antwort enthält einen Codeblock, der nicht richtig extrahiert werden konnte. Wenn Sie ihn sehen möchten, bitten Sie Pitxu, Ihnen die vollständige Antwort per E-Mail oder ähnlichem zu senden."
  
  # Long term memory
  memory:
    entry_creation_error:
      ca: "Ho sento, hi ha hagut un error al crear l'entrada de memòria."
      es: "Lo siento, ha habido un error al crear la entrada de memoria."
      en: "I'm sorry, there was an error creating the memory entry."
      de: "Es tut mir leid, es gab einen Fehler beim Erstellen des Gedächtniseintrags."
    entries_not_found:
      ca: "Ho sento, no s'han trobat entrades de memòria per a %s."
      es: "Lo siento, no se encontraron entradas de memoria para %s."
      en: "I'm sorry, memory entries were not found for %s."
      de: "Es tut mir leid, die Gedächtniseinträge wurden für %s nicht gefunden."
    entry_not_found:
      ca: "Ho sento, no s'ha trobat cap entrada de memòria relacionada amb %s."
      es: "Lo siento, no se ha encontrado ninguna entrada de memoria relacionada con %s."
      en: "I'm sorry, no memory entry was found related to %s."
      de: "Es tut mir leid, es wurde kein Gedächtniseintrag in Bezug auf %s gefunden."
    retrieval_error:
      ca: "Ho sento, hi ha hagut un error en recuperar les entrades de memòria."
      es: "Lo siento, ha habido un error al recuperar las entradas de memoria."
      en: "I'm sorry, there was an error retrieving the memory entries."
      de: "Es tut mir leid, es gab einen Fehler beim Abrufen der Gedächtniseinträge."
    notification:
      saved:
        ca: "Desat a la memòria"
        es: "Guardado en la memoria"
        en: "Saved to memory"
        de: "Im Gedächtnis gespeichert"
      updated:
        ca: "Memòria actualitzada"
        es: "Memoria actualizada"
        en: "Memory updated"
        de: "Gedächtnis aktualisiert"
      correction_pending:
        ca: "Correcció pendent"
        es: "Corrección pendiente"
        en: "Correction pending"
        de: "Korrektur ausstehend"
      forget_registered:
        ca: "Petició d'oblidar registrada"
        es: "Petición de olvidar registrada"
        en: "Forget request registered"
        de: "Bitte zu vergessen registriert"
      forgotten:
        ca: "Oblidat"
        es: "Olvidado"
        en: "Forgotten"
        de: "Vergessen"
    long_term_correction_saved:
      ca: "Desat com a correcció pendent de la memòria a llarg termini. Ja és visible i s'aplicarà durant la nit."
      es: "Guardado como corrección pendiente de la memoria a largo plazo. Ya es visible y se aplicará durante la noche."
      en: "Saved as a pending correction of the long term memory. It is visible right away and will be applied overnight."
      de: "Als ausstehende Korrektur des Langzeitgedächtnisses gespeichert. Sie ist sofort sichtbar und wird über Nacht übernommen."
    long_term_forget_registered:
      ca: "La memòria a llarg termini no es pot esborrar. S'ha registrat la petició d'oblidar-ho, però la informació es manté."
      es: "La memoria a largo plazo no se puede borrar. Se ha registrado la petición de olvidarlo, pero la información se mantiene."
      en: "The long term memory cannot be deleted. The request to forget it was registered, but the information is kept."
      de: "Das Langzeitgedächtnis kann nicht gelöscht werden. Die Bitte, es zu vergessen, wurde registriert, die Information bleibt aber erhalten."
    short_entry_deleted:
      ca: "Entrada esborrada."
      es: "Entrada borrada."
      en: "Entry deleted."
      de: "Eintrag gelöscht."
    entry_protected:
      ca: "Aquesta entrada no es pot modificar."
      es: "Esta entrada no se puede modificar."
      en: "This entry cannot be modified."
      de: "Dieser Eintrag kann nicht geändert werden."
    invalid_entry_id:
      ca: "L'identificador %s no és vàlid. Fes servir l'identificador tal com el vas rebre, com S:12 o L:5."
      es: "El identificador %s no es válido. Usa el identificador tal como lo recibiste, como S:12 o L:5."
      en: "The id %s is not valid. Use the id exactly as it was returned, like S:12 or L:5."
      de: "Die ID %s ist nicht gültig. Verwende die ID genau so, wie du sie erhalten hast, etwa S:12 oder L:5."
    summarization_error:
      ca: "Ho sento, hi ha hagut un error en resumir l'historial de xat en una entrada de memòria."
      es: "Lo siento, ha habido un error al resumir el historial de chat en una entrada de memoria."
      en: "I'm sorry, there was an error summarizing the chat history into a memory entry."
      de: "Es tut mir leid, es gab einen Fehler beim Zusammenfassen des Chatverlaufs in einen Gedächtniseintrag."
    summarization_error_no_summary_fields:
      ca: "Ho sento, el resum de l'historial de xat no conté camps de resum per crear una entrada de memòria."
      es: "Lo siento, el resumen del historial de chat no contiene campos de resumen para crear una entrada de memoria."
      en: "I'm sorry, the summary of the chat history does not contain fields to create a memory entry."
      de: "Es tut mir leid, die Zusammenfassung des Chatverlaufs enthält keine Felder, um einen Gedächtniseintrag zu erstellen."
    summarization_error_invalid_json:
      ca: "Ho sento, el resum de l'historial de xat no és un JSON vàlid per crear una entrada de memòria."
      es: "Lo siento, el resumen del historial de chat no es un JSON válido para crear una entrada de memoria."
      en: "I'm sorry, the summary of the chat history is not a valid JSON to create a memory entry."
      de: "Es tut mir leid, die Zusammenfassung des Chatverlaufs ist kein gültiges JSON, um einen Gedächtniseintrag zu erstellen."
