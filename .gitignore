# Python stuff
**/__pycache__/
.pytest_cache

# No secrets nor sessions
*.secret
*.session
.env

# Logs
log/*
!log/chats

# No user files
storage/*.yaml
storage/mocked/eink/*
storage/mocked/matrix/*
storage/mocked/lcd/*
storage/mocked/dsi_lcd/*
storage/audio/**
!**/.keep
storage/audio/input/*.wav
storage/audio/preprocessed_input/*.wav
storage/audio/signals/*.png
storage/audio/spectograms/*.png
storage/tmp/*.png
storage/tmp/*.html
storage/db/*.db

# No Wisper models
storage/whisper/*.pt

# No Faster Whisper models
storage/faster_whisper/**

# No user config files
config.yaml
config/*.yaml

# Keep the requirements.txt to be generated by the user
requirements.txt

# No Mac Stuff
.DS_Store

# No VSCode settings
.vscode/